# A bare name matches at the root only; `**/` matches at any depth.

# Version control
.git
.gitignore
.gitattributes

# Python
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.egg-info
.Python
.venv
venv
env
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Node
**/node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Environment / secrets, at any depth: the production .env lives in
# .phoxtail/deploy/
**/.env
**/.env.*

# The CLI's local state: deploy files with production secrets, MCP uploads
.phoxtail

# Every hidden file or folder at the root: local tool and editor state, which
# may hold credentials and which the app never reads
.*

# Database dumps hold every user's data
**/*.sql

# Runtime state (bind-mounted at runtime, must not be in the build context)
certbot
db-backups
media
static

# Editor / OS
.vscode
.idea
**/.DS_Store
**/*.swp
**/*.swo

# Docker / deploy artefacts
Dockerfile
docker-compose*.yaml
docker-compose*.yml
.dockerignore

# Docs
docs/_build
site
