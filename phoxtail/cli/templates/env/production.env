# Environment
DJANGO_ENV=production

# Django Core
SECRET_KEY={{ secret_key }}
ALLOWED_HOSTS={{ allowed_hosts }}
CSRF_TRUSTED_ORIGINS={{ csrf_origins }}
SITE_NAME={{ site_name }}

# Database
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Domain
DOMAIN={{ domain }}
DOMAIN_EMAIL={{ domain_email }}

# Email
{% if use_smtp %}
USE_SMTP_EMAIL_BACKEND=true
EMAIL_HOST={{ email_host }}
EMAIL_PORT={{ email_port }}
EMAIL_USE_TLS={{ email_use_tls | lower }}
EMAIL_HOST_USER={{ email_host_user }}
EMAIL_HOST_PASSWORD={{ email_host_password }}
DEFAULT_FROM_EMAIL={{ default_from_email }}
{% else %}
USE_SMTP_EMAIL_BACKEND=false
{% endif %}

# Redis
REDIS_URL=redis://redis:6379/0

# Features
PHOXTAIL_ALLOW_SIGNUP={{ allow_signup | lower }}

# Backup
BACKUP_FILE=yyyy-mm-dd.sql

{% if server_ip %}
# Deploy identity — used to guard against deploying to the wrong server
SERVER_IP={{ server_ip }}
{% endif %}
