#cloud-config

# -----------------------------------------------------------------------
# Phoxtail server bootstrap
# Runs once on first boot. By the time cloud-init finishes, the server
# has a hardened non-root user, Docker, and uv ready.
# -----------------------------------------------------------------------

# Create the deploy user with sudo and Docker access
users:
  - name: {{ deploy_user }}
    groups: users, sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
{% for key in ssh_public_keys %}
      - {{ key }}
{% endfor %}

# Keep cloud-init's package step from wedging dpkg.
# An image can ship grub-pc with a stored install device that doesn't exist,
# in which case the first grub-pc upgrade fails and leaves dpkg
# half-configured — and dpkg refuses to do anything else until that's
# resolved, which fails the package step, then every later apt-get, Docker's
# included. Acting only when the stored value is invalid keeps this a no-op
# on a healthy image, so it needs no removal once such an image is fixed.
bootcmd:
  - |
    set -u
    current=$(debconf-show grub-pc 2>/dev/null \
      | sed -n 's|^[* ] *grub-pc/install_devices: ||p')
    if [ -n "${current:-}" ] && [ ! -e "$current" ]; then
      # Decline the install rather than redirect it at a detected disk: an
      # image that stores an unusable device never had a working grub-pc
      # install to preserve, and on a whole-disk filesystem grub-install
      # fails outright ("blocklists are invalid"). Skipping leaves the
      # bootloader exactly as the image shipped it.
      printf '%s\n' \
        'grub-pc grub-pc/install_devices multiselect' \
        'grub-pc grub-pc/install_devices_empty boolean true' \
        'grub-pc grub-pc/install_devices_failed boolean false' \
        | debconf-set-selections
    fi
    # Nothing is stuck yet on a first boot — the preseed above is what keeps
    # the package step clean. This covers later boots, and any state the
    # preseed didn't anticipate.
    DEBIAN_FRONTEND=noninteractive dpkg --configure -a || true

# Install security and utility packages
packages:
  - fail2ban
  - ufw
  - unattended-upgrades
  - git
  - curl

package_update: true
package_upgrade: true

write_files:
  # SSH hardening — drop-in file so it doesn't touch the main sshd_config
  - path: /etc/ssh/sshd_config.d/99-phoxtail-hardening.conf
    permissions: "0600"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      MaxAuthTries 3
      AllowTcpForwarding no
      X11Forwarding no
      AllowAgentForwarding no
      AuthorizedKeysFile .ssh/authorized_keys
      AllowUsers {{ deploy_user }}

  # Auto-apply security updates without rebooting
  - path: /etc/apt/apt.conf.d/51phoxtail-unattended-upgrades
    content: |
      Unattended-Upgrade::Automatic-Reboot "false";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Mail "root";

  # fail2ban — protect SSH on default port
  - path: /etc/fail2ban/jail.local
    content: |
      [sshd]
      enabled = true
      port = ssh
      banaction = iptables-multiport
      maxretry = 3
      findtime = 300
      bantime = 3600

runcmd:
  # The recovery path, and not a formality: when the package step above still
  # wedges dpkg, retrying the configure here is what clears it — grub-pc's
  # postinst tolerates a failure it has already recorded. Everything below
  # needs a working dpkg, Docker's apt-get calls first among them.
  - DEBIAN_FRONTEND=noninteractive dpkg --configure -a || true

  # Install Docker (official convenience script — installs engine + compose plugin)
  - curl -fsSL https://get.docker.com | sh
  # Add deploy user to docker group so it can run docker without sudo
  - usermod -aG docker {{ deploy_user }}

  # btop — nice-to-have; installed best-effort so an older image without it
  # (pre btop-in-repo Ubuntu/Debian) can't fail the security packages above
  - apt-get install -y btop || true

  # Install uv (Python package manager) as the deploy user
  - su - {{ deploy_user }} -c "curl -LsSf https://astral.sh/uv/install.sh | sh"

  # Enable services
  - systemctl enable fail2ban
  - systemctl start fail2ban

  # Firewall — allow SSH, HTTP, HTTPS only
  - ufw allow ssh
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

  # Restart SSH to apply hardening config (new connections use hardened config,
  # existing root session stays open until the server reboots or it's closed)
  - systemctl restart ssh

  # Last runcmd wins: cloud-init reports only the final exit status, so end on
  # the check that matters. Without this a failed Docker install is invisible.
  - docker --version
